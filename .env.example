# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-random-secret-of-at-least-32-characters"

# MVP demo mode returns the OTP in the UI. Change this when an SMS provider is connected.
OTP_MODE="demo"

OPENAI_API_KEY=""

OPENAI_BASE_URL=https://api.avalai.ir/v1

VISION_MODEL=gpt-4o-mini

LLM_MODEL=gpt-4o-mini

# Neshan Map API (replace with your real key)
NESHAN_API_KEY="your_neshan_api_key_here"

# Public HTTPS address after deployment (without a trailing slash)
NEXT_PUBLIC_APP_URL="https://example.com"
