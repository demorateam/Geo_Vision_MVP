generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  phone     String     @unique
  role      String     @default("CITIZEN")
  agency    String?
  createdAt DateTime   @default(now())
  incidents Incident[] @relation("ReporterIncidents")
}

model Operator {
  id            String     @id @default(cuid())
  name          String
  phone         String
  personnelCode String     @unique
  agency        String
  status        String     @default("AVAILABLE")
  vehicle       String?
  pinHash       String?
  pinSalt       String?
  isActive      Boolean    @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  incidents     Incident[] @relation("AssignedOperatorIncidents")

  @@index([agency])
  @@index([status])
}

model Incident {
  id                 String                  @id @default(cuid())
  incidentNumber     String                  @unique
  reporterId         String
  assignedOperatorId String?
  imageUrl           String
  description        String
  latitude           Float
  longitude          Float
  address            String? 
  region             String
  incidentType       String
  severity           String                  @default("Low")
  colorCode          String                  @default("Green")
  aiSummary          String?
  status             String                  @default("PENDING")
  operatorStatus     String?
  assignedAt         DateTime?
  acceptedAt         DateTime?
  enRouteAt          DateTime?
  arrivedAt          DateTime?
  workStartedAt      DateTime?
  completedAt        DateTime?
  completionNote     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  reporter           User                    @relation("ReporterIncidents", fields: [reporterId], references: [id])
  assignedOperator   Operator?               @relation("AssignedOperatorIncidents", fields: [assignedOperatorId], references: [id], onDelete: SetNull)
  agencies           IncidentAgency[]
  statusHistory      IncidentStatusHistory[]

  @@index([reporterId])
  @@index([assignedOperatorId])
  @@index([status])
  @@index([severity])
  @@index([region])
}

model IncidentAgency {
  id         String   @id @default(cuid())
  incidentId String
  agencyName String
  assignedAt DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([agencyName])
}

model IncidentStatusHistory {
  id         String   @id @default(cuid())
  incidentId String
  oldStatus  String?
  newStatus  String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}
